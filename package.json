{
  "name": "lite",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev",
    "build:web": "rm -f public/page.js public/chunk-*.js && esbuild web/page.ts --bundle --splitting --format=esm --target=es2022 --outdir=public --entry-names=[name] --chunk-names=chunk-[hash]",
    "build:docs": "npm --prefix site run build",
    "deploy": "npm run build:web -- --minify && npm run build:docs && wrangler deploy",
    "test": "node scripts/run-unit.ts",
    "typecheck": "tsc --noEmit && tsc -p web --noEmit",
    "watch": "node cli/watch.ts",
    "check": "node scripts/check.ts",
    "test:changed": "node scripts/changed.ts",
    "test:inventory": "node scripts/inventory.ts",
    "ship:local": "node scripts/ship-local.mjs",
    "types": "wrangler types src/worker-configuration.d.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "agents": "0.31.0",
    "shaders": "4.0.6",
    "three": "0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/three": "0.187.0",
    "typescript": "7.0.2",
    "wrangler": "4.154.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true,
    "core-js-pure": false
  }
}
